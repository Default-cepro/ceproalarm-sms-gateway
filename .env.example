# ===== Servidor =====
SMS_GATE_SERVER_HOST=0.0.0.0
SMS_GATE_SERVER_PORT=8000
SMS_GATE_ACCESS_LOG=0

# ===== Registro de webhooks en Cloud (opcional) =====
SMS_GATE_AUTO_REGISTER_WEBHOOKS=0
SMS_GATE_UNREGISTER_ON_EXIT=0
SMS_GATE_API_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATE_API_USERNAME=
SMS_GATE_API_PASSWORD=
SMS_GATE_WEBHOOK_URL=
SMS_GATE_WEBHOOK_EVENTS=sms:received,sms:sent,sms:delivered,sms:failed
SMS_GATE_DEVICE_ID=

# ===== Verificación de firma de webhooks =====
SMS_GATE_WEBHOOK_SIGNING_KEY=
SMS_GATE_REQUIRE_SIGNATURE=0
SMS_GATE_TIMESTAMP_TOLERANCE_SECONDS=300
SMS_GATE_MAX_TRACKED_DELIVERIES=5000

# ===== API local (app SMS Gateway en modo Local server / ADB) =====
SMS_GATE_LOCAL_API_ENABLED=0
SMS_GATE_LOCAL_API_BASE_URL=http://127.0.0.1:18080
SMS_GATE_LOCAL_API_USERNAME=sms
SMS_GATE_LOCAL_API_PASSWORD=
SMS_GATE_LOCAL_API_COUNTRY_CODE=58

# ===== Archivos Excel =====
# Archivo, carpeta o glob de los .xlsx a procesar (p. ej. data/lote_1/*.xlsx)
EXCEL_PATH=

# ===== Comportamiento de envío SMS =====
SMS_GATE_SMS_RETRIES=1
SMS_GATE_SMS_RETRY_DELAY_SECONDS=30
SMS_GATE_SMS_TIMEOUT_SECONDS=30

# ===== Scheduler 24/7 =====
SMS_GATE_SCHEDULE_ENABLED=1
SMS_GATE_DAILY_RUN_TIMES=08:00,14:00,20:00
SMS_GATE_SKIP_PAST_ROUNDS=1
SMS_GATE_SKIP_GRACE_SECONDS=60
# Opcional. Ej. America/Caracas. Vacío = zona local del sistema.
SMS_GATE_TIMEZONE=
SMS_GATE_MAINTENANCE_FLAG_PATH=data/maintenance.pause
SMS_GATE_MAINTENANCE_RECHECK_SECONDS=60
SMS_GATE_PERSISTENCE_ENABLED=1
SMS_GATE_PERSISTENCE_PATH=data/run_state.json

# ===== Alertas OFFLINE al cierre del día =====
SMS_GATE_OFFLINE_ALERT_RECIPIENTS=04143417356

# ===== Reporte por correo al cierre del día =====
EMAIL_REPORT_ENABLED=0
EMAIL_REPORT_RECIPIENTS=
EMAIL_REPORT_SUBJECT_PREFIX=Ceproalarm SMS Gateway
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_USE_SSL=0
EMAIL_SMTP_USE_TLS=1
EMAIL_SMTP_TIMEOUT_SECONDS=20

# ===== Logging =====
# Ruta del archivo de log (vacío = logs/app.log; "stdout" = solo consola)
SMS_GATE_LOG_PATH=
